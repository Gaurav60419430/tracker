# Multi-user + many-year persistence — FREE Turso DB (no paid keys needed).
# Anyone can Sign up on /login; each account gets an isolated ledger (new vaults start ₹0/₹0).
# Without TURSO_*, production falls back to per-isolate memory (ephemeral) + per-user localStorage cache.

# Auth signing secret — generate once, set same value on Vercel + Cloudflare (any random 32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-in-production

# Option A: Turso (recommended — FREE tier, works on Cloudflare Workers, Vercel Node, local)
# Create: turso db create money-tees && turso db show money-tees --url && turso db tokens create money-tees
TURSO_DATABASE_URL=libsql://money-tees-yourname.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Option B: Generic libSQL HTTP URL
# DATABASE_URL=libsql://...
# DATABASE_AUTH_TOKEN=...

# Option C: Local file for dev only (ephemeral on Vercel/Workers, durable locally for years)
# DATABASE_FILE_URL=file:./data/money-tees.db

# For Vercel Postgres (alternative), set DATABASE_URL=postgres://... and run db:push with postgres dialect
# This project uses Drizzle + libSQL; for Postgres, change lib/db/index.ts driver.

# Cloudflare D1 (if you prefer D1 over Turso): set binding name 'DB' in wrangler.json and use drizzle-orm/d1
# See lib/db/index.ts comments.
